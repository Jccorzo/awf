{
  "name": "agent-waterfall",
  "version": "0.1.0",
  "description": "Agent waterfall: see where a coding agent's time went, by phase.",
  "type": "module",
  "license": "MIT",
  "author": "Camilo Corzo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jccorzo/awf.git"
  },
  "homepage": "https://github.com/Jccorzo/awf#readme",
  "bugs": {
    "url": "https://github.com/Jccorzo/awf/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "ai-agent",
    "cli",
    "timing",
    "profiling",
    "waterfall",
    "developer-tools"
  ],
  "bin": {
    "awf": "dist/awf.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "pnpm lint && pnpm test",
    "test": "hushrun run -- vitest run",
    "test:watch": "vitest",
    "lint": "hushrun run -- eslint . && hushrun run -- prettier --check . && hushrun run -- tsc --noEmit",
    "format": "prettier --write .",
    "awf": "node scripts/build.mjs --quiet --cli-only && node dist/awf.mjs",
    "scrub": "node scripts/run-ts.mjs scripts/scrub.ts",
    "report:sample": "node scripts/run-ts.mjs scripts/sample-report.ts",
    "report:screenshots": "node scripts/run-ts.mjs scripts/report-screenshots.ts",
    "prepare": "hushrun hook install || exit 0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hushrun": "^0.7.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "hushrun": {
    "backend": "https://api.hushrun.com/o/jccorzot"
  }
}
